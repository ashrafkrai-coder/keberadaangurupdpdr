rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.role == 'admin';
    }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /teachers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
      // Pendaftaran sendiri: hanya e-mel DELIMa yang disahkan; aktif serta-merta (admin boleh nyahaktifkan)
      allow create: if isAdmin() ||
        (request.auth.uid == uid
         && request.auth.token.email_verified == true
         && request.auth.token.email.matches('.*@moe-dl[.]edu[.]my')
         && request.resource.data.keys().hasOnly(['name','email','role','session','active','pending','createdAt'])
         && request.resource.data.role == 'guru'
         && request.resource.data.active == true
         && request.resource.data.email == request.auth.token.email
         && request.resource.data.session in ['pagi','petang','kedua-dua']);
      allow update: if isAdmin() ||
        // Guru hanya boleh mendaftar lokasi rumah SEKALI (admin boleh reset)
        (request.auth.uid == uid
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['home'])
         && !('home' in resource.data)
         && request.resource.data.home.keys().hasOnly(['lat','lng','accuracy','setAt'])
         && request.resource.data.home.lat is number
         && request.resource.data.home.lng is number);
    }

    // Satu rekod per guru per sesi per hari. ID = tarikh_uid_sesi (tiada pendua).
    match /checkins/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.active == true
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.session in ['pagi', 'petang']
        && request.resource.data.homeStatus in ['dalam', 'luar']
        && request.resource.data.timestamp == request.time
        && id == request.resource.data.date + '_' + request.auth.uid + '_' + request.resource.data.session;
      allow update, delete: if false;
    }
  }
}
