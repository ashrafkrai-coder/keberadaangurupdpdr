rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.role == 'admin';
    }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /teachers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, delete: if isAdmin();
      // Guru hanya boleh ubah medan lokasi/status miliknya sendiri
      allow update: if isAdmin() ||
        (request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['sharing','lastLocation','lastUpdate','geofence','status','source','battery']));
    }

    match /teachers/{uid}/history/{id} {
      allow read: if isAdmin() || request.auth.uid == uid;
      allow create: if request.auth.uid == uid || isAdmin();
      allow update, delete: if false;
    }
  }
}
